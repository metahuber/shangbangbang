# =============================================================================
# 商帮帮 · 生产环境变量（一台服务器跑两个站点：门户 + 外贸站）
#
# 用法：
#   cd deploy
#   cp .env.example .env
#   然后照着下面每一项的说明改成你自己的值
#
# ⚠️⚠️ 这个 .env 里全是密码和密钥：
#   1. 不要提交到 git（项目 .gitignore 已经忽略 .env）
#   2. 不要发给任何人，包括截图发群里
#   3. 服务器上把权限收紧：chmod 600 .env
#
# 赋值写法：等号两边**不要**加空格，值里如果有 # 或空格要用引号包起来。
# =============================================================================


# -----------------------------------------------------------------------------
# 一、两个站点的域名 / 证书
#     ⚠️ 这一段最关键，改错了 Caddy 会起不来（同一个域名被两个站点块认领）。
#        改完务必看一眼 Caddyfile 顶部「域名撞车怎么查」那一节。
# -----------------------------------------------------------------------------

# 【门户】商帮帮自己的官网域名（纯静态页面 + 留资接口）。
#   面向国内客户。Caddyfile 里会同时给下面这两个名字建站点块：
#     {$PORTAL_DOMAIN}  和  www.{$PORTAL_DOMAIN}
#
#   ⚠️ 两条硬规则：
#     1. 默认值就等于 ROOT_DOMAIN（shangbangbang.com）—— 也就是
#        「门户占根域名和 www，外贸站只占子域名」，这是推荐安排。
#     2. **绝对不要**把它写成 ROOT_DOMAIN 的子域名
#        （比如 portal.shangbangbang.com）：那样它会和 Caddyfile 里的
#        通配块 *.shangbangbang.com 抢同一个域名，Caddy 直接报错起不来。
#        要用别的域名，就用**完全另一套**域名（比如 shangbangbang.cn）。
#
#   注意：只写域名，不要写 https:// 或结尾的斜杠。
PORTAL_DOMAIN=shangbangbang.com

# 【门户】门户自己的对外完整地址，**构建期**变量（会被内联进打包产物）。
#   用途：canonical 链接、sitemap.xml、robots.txt 里写哪个地址。
#   ⚠️ 改了必须重新构建门户镜像才生效：docker compose build portal
#   （只改这里再 restart portal 是没用的，原因见 README「改环境变量」一节。）
PORTAL_SITE_URL=https://shangbangbang.com

# 【外贸站】根域名：客户站点都是 客户名.这个域名
#   Caddyfile 里用它拼通配符证书（*.shangbangbang.com）。
#   注意：只写域名，不要写 https:// 或结尾的斜杠。
ROOT_DOMAIN=shangbangbang.com

# ACME 证书账号邮箱。填一个你常用的、能收邮件的邮箱。
# 证书出问题时 CA 会发邮件到这里；平时收不到邮件是正常的。
ACME_EMAIL=admin@shangbangbang.com

# ⚠️ CADDY_IMAGE 默认值是官方镜像 caddy:2-alpine，它**不带任何 DNS 插件**，
#    所以只能签单域名证书（客户自己绑的域名、逐个写的子域名都能签）。
#    如果你要 *.shangbangbang.com 通配符证书，必须自己编译一个带 DNS 插件的镜像，
#    然后把下面这行改成你编译出来的镜像名（做法见 README「DNS 怎么配」第 4 步）。
# CADDY_IMAGE=registry.example.com/my-caddy-dns:2

# ⚠️ 调试证书签发时，**不要改这里** —— 这个开关在 Caddyfile 里：
#    打开 deploy/Caddyfile，找到被注释掉的 acme_ca 那一行，取消注释：
#      acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
#    然后 docker compose restart caddy。
#    测试环境签的证书浏览器不认（会报不安全），但能验证流程通不通、
#    而且不消耗正式环境的签发次数限额。签通以后记得注释回去、再重启。


# -----------------------------------------------------------------------------
# 二、DNS 服务商凭据（只有配通配符证书才需要，不配就全部留空）
#     ⚠️ 每个 Caddy DNS 插件的变量名都不一样，下面几个是常见的，
#        用之前**必须**对照你那个插件的 README 确认变量名：
#        https://github.com/caddy-dns
# -----------------------------------------------------------------------------

# Cloudflare 的 API Token（在 Cloudflare 后台 → My Profile → API Tokens 生成，
# 权限至少要有 Zone → DNS → Edit，作用域限定到你这个域名）
CLOUDFLARE_API_TOKEN=

# 阿里云 DNS（RAM 子账号的 AccessKey，权限只给 DNS 相关）
ALICLOUD_ACCESS_KEY=
ALICLOUD_SECRET_KEY=

# 腾讯云 DNSPod
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=

# 通用兜底（有些插件读这个变量名）
DNS_API_TOKEN=


# -----------------------------------------------------------------------------
# 三、数据库（PostgreSQL）
#     POSTGRES_* 三个值只在**数据库第一次初始化**时生效：
#     卷建好之后再改用户名/密码，数据库里不会跟着变（要用 SQL 改，见 README）。
# -----------------------------------------------------------------------------

# 数据库名，随便起，比如 shangbangbang
POSTGRES_DB=shangbangbang

# 数据库用户名，别用 postgres 这个默认超级用户
POSTGRES_USER=sbb_app

# ⚠️ 必须换成强密码！这是整个系统最重要的密码之一。
#    生成方法（在服务器上执行）：
#      openssl rand -base64 32
#    或：  head -c 32 /dev/urandom | base64
#    密码里如果出现 $ 或 #，记得外面用引号包起来，例如 POSTGRES_PASSWORD='a$b#c'
POSTGRES_PASSWORD=CHANGE_ME_请换成一串随机密码

# 应用连接数据库用的完整连接串。
# 注意主机名写 db（docker compose 里的服务名），不是 localhost！
#
# 这里有两种用法，对应 README 第 5 步的「第一次构建」和「第二次构建」：
#   ① 构建期不连库（第一次上线、还没有表的时候用这个）：
#      DATABASE_URL=postgres://build:build@127.0.0.1:5432/build
#   ② 正常值（跑过一次迁移之后，构建期能连库，页面会被预渲染）：
#      DATABASE_URL=postgres://sbb_app:你的密码@db:5432/shangbangbang
#
# 记得把用户名、密码、库名和上面三个 POSTGRES_* 对上。
DATABASE_URL=postgres://build:build@127.0.0.1:5432/build


# -----------------------------------------------------------------------------
# 四、应用
# -----------------------------------------------------------------------------

# ⚠️⚠️ Payload 的加密密钥。用来签发后台登录态、加密敏感字段。
#    换掉它 = 所有已登录用户被强制登出；**绝对不能用开发时那个值**。
#    生成方法（在服务器上执行，32 字节随机数的十六进制）：
#      node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#    或者： openssl rand -hex 32
#    生成后**不要**再改，改了要重新登录后台（数据不会丢，但会话全失效）。
PAYLOAD_SECRET=CHANGE_ME_用上面命令生成一串随机值

# 默认站点标识：访问**外贸站的**根域名 / localhost / 没配过的域名时，显示哪个站点。
# 要和后台「站点（客户）」里某个站点的「站点标识」一致（比如 hengxin-tools）
DEFAULT_SITE=hengxin-tools

# 两个应用构建出来的镜像标签，一般不用改
PORTAL_IMAGE_TAG=latest
SITE_IMAGE_TAG=latest


# -----------------------------------------------------------------------------
# 五、门户的留资线索（选填，但正式上线强烈建议配）
# -----------------------------------------------------------------------------

# ⚠️ 门户的 /api/lead 接口目前是**临时方案**：把线索追加写到容器里的
#    /app/data/leads.jsonl（compose 里挂了具名卷 portal_data，重建容器不丢）。
#    这条链路只适合「刚上线、线索量很小」的阶段：
#      * 文件在服务器上，你在本地看不到，得 SSH 进去翻；
#      * 没有人知道来了新线索（没有邮件、没有微信提醒）；
#      * 服务器整台挂掉时，线索跟磁盘一起没了。
#
#    正式做法（任选其一，代码里已经留好了口子）：
#      1) 填下面这个 LEAD_WEBHOOK_URL，把每条线索转发到企业微信机器人 / 飞书 / 自建接口
#         —— 代码里已经写好了转发逻辑，**填上就生效，不用改代码**
#      2) 改成写数据库（门户目前没有库，要新加）
#
#    ⚠️ 填完之后：还要去 deploy/docker-compose.yml 的 portal 服务里，
#       把 `# LEAD_WEBHOOK_URL: ${LEAD_WEBHOOK_URL}` 这行的注释去掉，
#       否则变量只是躺在 .env 里，不会进容器。
#    ⚠️ 这条 URL 里通常带机器人密钥，等同于密码，别外传。
# LEAD_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=你的key


# -----------------------------------------------------------------------------
# 六、首次上线开关
# -----------------------------------------------------------------------------

# 容器启动时先自动跑一次 `payload migrate`（把表结构建起来）。
#   * **第一次上线**：改成 true，跑完整套流程、确认站点能打开后，再改回 false
#   * 平时：保持 false。迁移改由你手动执行，避免每次重启都动数据库结构
RUN_MIGRATIONS=false
